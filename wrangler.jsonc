{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prepperslop-project",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "prepperslop-db","database_id": "9f8b948a-3729-4fd2-b266-aafc96bfe591",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "prepperslop-media","preview_bucket_name": "prepperslop-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
